#
# Copy to deploy/.env and fill in. Never commit the result.
#   cp deploy/env.deploy.example deploy/.env

# --- Hosting -----------------------------------------------------------------
DASHBOARD_DOMAIN=dashboard.example.org
ACME_EMAIL=you@example.org

# Capability ceiling: public (browse-only) or judge (adds LLM-as-judge for
# allowlisted signed-in users). `full` is refused on a non-loopback bind.
TEXT2SQL_DASHBOARD_MODE=judge

# --- Data --------------------------------------------------------------------
# Pin the Hugging Face snapshot. Without an explicit revision the toolkit falls
# back to `main`, and the public data would change under shared links.
TEXT2SQL_RESULTS_REVISION=v1.1.0

# --- Sign-in -----------------------------------------------------------------
# Google OAuth credentials. Redirect URI must be:
#   https://<DASHBOARD_DOMAIN>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, sessions do not survive a restart.
TEXT2SQL_SESSION_SECRET=

# Comma-separated. Only these addresses reach the judge tier.
TEXT2SQL_JUDGE_ALLOWLIST=you@example.com

# --- LLM-as-judge ------------------------------------------------------------
WATSONX_APIKEY=
WATSONX_API_BASE=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECTID=

TEXT2SQL_JUDGE_MONTHLY_BUDGET_USD=50
TEXT2SQL_JUDGE_DISABLED=false
# USD per million tokens as {"model": [prompt, completion]}. The default is an
# ESTIMATE -- calibrate against a real invoice, and keep a budget alert on the
# watsonx account as well, since an understated rate lets the meter overrun.
# TEXT2SQL_JUDGE_RATES={"default": [0.60, 1.80]}

# --- Databases (only with `--profile databases`) ------------------------------
# Superuser passwords are used by the init scripts to create SELECT-only roles.
# The app itself never gets these.
POSTGRES_SUPERUSER_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Read-only application credentials, internal hostnames only.
# POSTGRES_CONNECTION_STRING=postgresql://readonly:CHANGEME@postgres:5432/bird
# MYSQL_CONNECTION_STRING=mysql://readonly:CHANGEME@mysql:3306/beaver
